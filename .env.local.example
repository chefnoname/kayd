# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nwqxzmqmerfohjgoqgdx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7KKRt5o5DNbN9uzjQMpDhQ_Pls13Xzm
# Server-only. Supabase > Project Settings > API keys > secret / service_role.
# Needed for team invites, password resets, user admin and the rate fetch job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL used in invite / signup / password-reset email links.
# Use http://localhost:3000 locally and https://kayd.live in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kayd Console (internal). When set, the console only answers on this host
# (e.g. console.kayd.live) and every other host returns 404 for /console.
# Leave unset locally to use http://localhost:3000/console.
# CONSOLE_HOST=console.kayd.live

# Optional: booking link on the /home landing page (has a default)
# CALENDLY_URL=https://calendly.com/your-link

# Exchange rate automation
# Generate a strong random secret: openssl rand -hex 32
RATES_API_SECRET=your-rates-api-secret-here
# Primary: https://www.exchangerate-api.com (free tier: 1,500 req/month)
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key-here
# Fallback: https://openexchangerates.org (free tier: 1,000 req/month)
OPEN_EXCHANGE_RATES_KEY=your-open-exchange-rates-key-here
